{
  "name": "@rsc-gl/react",
  "version": "0.1.0",
  "description": "React bindings for the GPU charting engine: composable children API and props-driven chart components.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "@rsc-gl/source": "./src/index.ts", "default": "./dist/index.js" },
    "./*": { "types": "./dist/*.d.ts", "@rsc-gl/source": "./src/*.tsx", "default": "./dist/*.js" }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@rsc-gl/core": "0.1.0",
    "@rsc-gl/gpu": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
