{
  "name": "@rsc-gl/3d",
  "version": "0.1.0",
  "description": "3D charts (bars, stacked and shaped bars, scatter, surfaces with contours, pies, ribbons, globes, networks, vector fields, histograms, funnels, treemaps, prism maps, trajectories) for the GPU charting engine. Framework agnostic core plus React bindings at @rsc-gl/3d/react.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@rsc-gl/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "@rsc-gl/source": "./src/react.tsx",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@rsc-gl/core": "0.1.0",
    "@rsc-gl/gpu": "0.1.0",
    "@rsc-gl/react": "0.1.0",
    "d3-geo": "^3.1.2",
    "d3-hierarchy": "^3.1.3",
    "earcut": "^3.2.4"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
